# Recreated and hash-checked by setup:software.
# 只忽略二进制 wasm，保留许可证文本（LGPL 合规要求）。
/public/software/*
!/public/software/*.txt
!/public/software/LICENSE*

# ===== 星幕剧场：安卓 TV 版 =====
# 签名私钥绝不入库；本地 SDK 路径因人而异。
android/app/keystore/
android/local.properties
android/.gradle/
android/build/
android/app/build/
# 网页资源由 scripts/build-android-assets.mjs 生成，不重复入库。
android/app/src/main/assets/assets/
android/app/src/main/assets/bridge.js
android/app/src/main/assets/index.html
*.apk
*.jks
*.keystore

