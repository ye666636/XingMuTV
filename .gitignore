# 星幕剧场 · 安卓 APK 源码仓库忽略规则

# Node 依赖与前端构建产物
node_modules/
dist-react/
dist/

# 安卓构建产物、本地 SDK 路径与签名私钥（绝不入库）
android/app/keystore/
android/local.properties
android/.gradle/
android/build/
android/app/build/
*.apk
*.jks
*.keystore

# 由 scripts/build-android-assets.mjs 生成的 assets，不重复入库
android/app/src/main/assets/assets/
android/app/src/main/assets/bridge.js
android/app/src/main/assets/index.html

# 本机联调脚本（含绝对路径，不进公开仓库）
scripts/_*.py
scripts/_*.ps1

# 编辑器 / 系统 / 缓存
.DS_Store
.idea/
.vscode/
*.log
*.tmp
__pycache__/
*.pyc
.workbuddy/
